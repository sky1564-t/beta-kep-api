# ─────────────────────────────────────────────
#  Vipassana Dhura CMS — copy this file to .env
# ─────────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=1337
# Public address of this backend (used for links), e.g. https://cms.kepvipassana.org
PUBLIC_URL=
# true when running behind Nginx / a load balancer
IS_PROXIED=false

# Secrets — generate new random values for production:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=kep_cms
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
DATABASE_FILENAME=.tmp/data.db

# Languages: first one is the default
CMS_LOCALES=km,en
CMS_DEFAULT_LOCALE=km
# true = add demo pages/courses/photos on the first start (only when there are no pages yet)
SEED_DEMO=false
SITE_TIMEZONE=Asia/Phnom_Penh

# Websites allowed to call the API from the browser
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,https://kepvipassana.org,https://www.kepvipassana.org

# Image uploads
UPLOAD_MAX_MB=25
# local = save in public/uploads on this server | s3 = Cloudflare R2 / AWS S3
UPLOAD_PROVIDER=local

# --- only when UPLOAD_PROVIDER=s3 ---
# Cloudflare R2 example:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://media.kepvipassana.org   (R2 custom domain or r2.dev URL)
#   S3_ACL=                                         (leave empty for R2)
# AWS S3 example: S3_ENDPOINT= (empty), S3_REGION=ap-southeast-1, S3_ACL=public-read (only if the bucket uses ACLs)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_ROOT_PATH=uploads
S3_ACL=
S3_FORCE_PATH_STYLE=false
