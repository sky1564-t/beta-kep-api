{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Site settings",
    "description": "Logo, menu, contact, social links, donation, footer, default SEO"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tagline": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "headerMenu": {
      "type": "component",
      "repeatable": true,
      "component": "shared.menu-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footerMenu": {
      "type": "component",
      "repeatable": true,
      "component": "shared.menu-link",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contact": {
      "type": "component",
      "repeatable": false,
      "component": "shared.contact",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "donation": {
      "type": "component",
      "repeatable": false,
      "component": "shared.donation",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footerText": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
