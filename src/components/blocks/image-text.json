{
  "collectionName": "components_blocks_image_texts",
  "info": {
    "displayName": "Image + text",
    "icon": "picture",
    "description": "Image beside text"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string"
    },
    "body": {
      "type": "blocks"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imagePosition": {
      "type": "enumeration",
      "enum": [
        "left",
        "right"
      ],
      "default": "left"
    },
    "buttonLabel": {
      "type": "string"
    },
    "buttonUrl": {
      "type": "string"
    },
    "anchor": {
      "type": "string",
      "regex": "^[a-z0-9-]*$"
    }
  }
}
